{
  "name": "syzygy-services-rn",
  "version": "3.0.0",
  "description": "Concrete I/O service implementations for the Syzygy React Native ecosystem",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syzygy-Hub/syzygy-services-rn.git"
  },
  "homepage": "https://github.com/Syzygy-Hub/syzygy-services-rn#readme",
  "bugs": {
    "url": "https://github.com/Syzygy-Hub/syzygy-services-rn/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist lib",
    "prebuild": "npm run clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "prepare": "npm run build"
  },
  "dependencies": {
    "syzygy-foundation-rn": "^3.0.0"
  },
  "devDependencies": {
    "@react-native-community/eslint-plugin": "^1.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.5.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
