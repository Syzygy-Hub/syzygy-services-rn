{
  "name": "syzygy-services-rn",
  "version": "1.0.0",
  "description": "Concrete I/O service implementations for the Syzygy React Native ecosystem",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syzygy-Hub/syzygy-services-rn.git"
  },
  "homepage": "https://github.com/Syzygy-Hub/syzygy-services-rn#readme",
  "bugs": {
    "url": "https://github.com/Syzygy-Hub/syzygy-services-rn/issues"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "clean": "rm -rf dist lib",
    "prebuild": "npm run clean",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest --passWithNoTests",
    "prepare": "npm run build"
  },
  "dependencies": {
    "syzygy-foundation-rn": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.4.0"
  }
}
